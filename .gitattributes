# Normalise line endings: LF in the repo, also when cloned on Windows
* text=auto eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch, never diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.bin  binary
*.hex  binary
*.elf  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.woff binary
*.woff2 binary
